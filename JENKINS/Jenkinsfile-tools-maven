pipeline {
    agent any

    // Configuration des outils à utiliser pour l'ensemble de la Pipeline
    tools {
        // On dit qu'on veut configurer l'outil Maven, id "maven-3.10.1"
        maven 'maven-3.10.1'
    }

    stages {
        stage('Maven') {
            steps {
                sh 'mvn -v'
            }
        }

        stage('Outil Maven spécifique') {
            // Configuration d'outils spécifique au stage
            tools {
                maven 'maven-3.9.10'
            }

            steps {
                sh 'mvn -v'
            }
        }
    }
}
