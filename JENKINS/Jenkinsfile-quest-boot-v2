pipeline {
    agent {
        docker {
            image 'maven:3.10.0-eclipse-temurin-21'
            args '''
                -v $HOME/.m2:/root/.m2:z
                -u root
            '''
        }
    }

    stages {
        stage('Git checkout') {
            steps {
                script {
                    git credentialsId: 'github-login',
                        url: 'git@github.com:jabid021/SOPRA-JAVA-260831-GIT.git',
                        branch: 'main'
                }
            }
        }

        stage('Maven Package') {
            steps {
                dir('BOOT-SECURITY/quest-boot') {
                    sh 'mvn clean package'
                }
            }
        }
    }
}
